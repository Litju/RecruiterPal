{
  "name": "recruiterpal",
  "version": "0.1.0",
  "private": true,
  "description": "RecruiterPal — the agent-driven workspace for evidence-based recruiting",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@recruiterpal/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:db": "pnpm --filter @recruiterpal/db test:db && pnpm --filter @recruiterpal/application test:db && pnpm --filter @recruiterpal/workflows test:db && pnpm --filter @recruiterpal/agent-runtime test:db",
    "test:e2e": "turbo run test:e2e",
    "test:workflows": "turbo run test:workflows",
    "evals": "turbo run evals",
    "db:generate": "pnpm --filter @recruiterpal/db generate",
    "db:migrate": "pnpm --filter @recruiterpal/db migrate",
    "db:seed": "pnpm --filter @recruiterpal/db seed",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:clean-room": "node scripts/scan-clean-room.mjs"
  },
  "devDependencies": {
    "@recruiterpal/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "lefthook": "^1.13.6",
    "prettier": "^3.6.2",
    "typescript-eslint": "8.67.0",
    "turbo": "^2.5.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cbor-extract",
      "esbuild",
      "lefthook",
      "sharp"
    ]
  }
}
