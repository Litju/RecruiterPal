  ],
  "properties": {
    "type": {
      "enum": [
        "FOCUS_EXCEPTION",
        "OPEN_APPLICATION_PANEL",
        "OPEN_EVIDENCE_MATRIX",
        "OPEN_SCORECARD_COMPARE",
        "FILTER_PIPELINE",
        "OPEN_TIMELINE_RANGE",
        "OPEN_ACTION_PREVIEW",
        "OPEN_DECISION_BRIEF",
        "OPEN_SCHEDULING_RESOLUTION",
        "NAVIGATE_SURFACE"
