{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteractionContext",
  "type": "object",
  "required": [
    "actorUserId",
    "organizationId",
    "permissions",
    "surface",
    "selectedEntityRefs",
    "timezone",
    "authorizationPolicyVersion"
  ],
  "properties": {
    "actorUserId": {
      "type": "string"
    },
    "organizationId": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "type": "string"
    },
    "selectedEntityRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "filters": {
      "type": "object"
    },
    "timezone": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "authorizationPolicyVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
