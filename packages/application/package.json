  "dependencies": {
    "@recruiterpal/contracts": "workspace:*",
    "@recruiterpal/db": "workspace:*",
    "@recruiterpal/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@recruiterpal/tsconfig": "workspace:*",
    "@types/pg": "^8.15.5",
    "@types/node": "^24.3.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
