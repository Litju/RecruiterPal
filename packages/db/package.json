{
  "name": "@recruiterpal/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/lint-package.mjs",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:start": "node ../../scripts/dev-db.mjs start",
    "db:stop": "node ../../scripts/dev-db.mjs stop",
    "test:unit": "vitest run --passWithNoTests --exclude tests/**/*.test.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@recruiterpal/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "@recruiterpal/contracts": "workspace:*",
    "better-auth": "^1.7.1"
  },
  "devDependencies": {
    "@recruiterpal/tsconfig": "workspace:*",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
