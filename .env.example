# ---- Never commit real values. This file documents required variable names only. ----

# Privileged server-only connection used by Better Auth and migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/recruiterpal

# Restricted application role used for tenant-scoped product queries.
RP_APP_DATABASE_URL=postgresql://rp_app:password@localhost:5432/recruiterpal

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# OpenCode Go model provider (agent turns fail closed when absent)
OPENCODE_GO_API_KEY=

# Optional live provider access tokens; leave empty to use explicit synthetic fixtures.
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Optional: error/performance telemetry
SENTRY_DSN=
